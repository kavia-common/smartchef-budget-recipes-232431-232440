# SmartChef Frontend environment variables (Create React App)
# Do NOT put secrets in source control. This file is safe to commit.

# Optional: route recipe calls through your backend (recommended for hiding provider keys)
REACT_APP_BACKEND_URL=

# Feature flags and experiments
# Example: REACT_APP_FEATURE_FLAGS=voice
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Optional provider keys (direct calls in dev only; prefer backend proxy)
REACT_APP_SPOONACULAR_API_KEY=
REACT_APP_EDAMAM_APP_ID=
REACT_APP_EDAMAM_APP_KEY=
